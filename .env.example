# Public/non-secret application settings. Copy this file to .env.
# Double underscore (__) maps to nested .NET configuration sections.

# Telegram bot token from @BotFather.
TELEGRAM__BOTTOKEN=replace-me

# PostgreSQL connection settings used by the bot.
DATABASE__HOST=localhost
DATABASE__PORT=5432
DATABASE__NAME=almaty_lis_polling_bot
DATABASE__USERNAME=postgres

# Main bot settings. IDs are Telegram numeric IDs; use 0 until configured.
BOT__APPLICATIONTIMEZONE=Asia/Almaty
BOT__MAINADMINUSERID=0
BOT__TARGETCHATID=0
BOT__DEFAULTPOLLSTOPTIME=21:00:00
BOT__DEFAULTVENUE="Tamos Education, Абиша Кекилбайулы, 129/4"

# CHGK API endpoint.
CHGKAPI__BASEURL=https://api.rating.chgk.info/

# Secrets are kept separately in secrets.env (see secrets.env.example):
# DATABASE__PASSWORD=replace-me
# POSTGRES_PASSWORD=replace-me
